{
  "name": "elite-emporium-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "format:check": "prettier --check .",
    "check": "tsc --project jsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "db:migrate": "node src/db/migrate.js up",
    "db:migrate:undo": "node src/db/migrate.js down",
    "db:seed": "node src/db/seed.js",
    "keys:generate": "node scripts/generate-jwt-keys.js",
    "media:ensure": "node scripts/ensure-media-directories.js",
    "openapi:validate": "node scripts/validate-openapi.js",
    "backup:create": "node scripts/create-backup.js",
    "backup:restore": "node scripts/restore-backup.js",
    "docker:smoke": "node scripts/docker-smoke.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "file-type": "^22.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "multer": "^2.3.0",
    "mysql2": "^3.14.4",
    "nodemailer": "^9.1.0",
    "otplib": "^13.5.0",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.1",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.1",
    "umzug": "^3.8.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.35.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
