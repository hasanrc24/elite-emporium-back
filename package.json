{
  "name": "elite-emporium-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "overrides": {
    "multer": "2.3.0",
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc --project tsconfig.json && node scripts/copy-assets.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "format:check": "prettier --check .",
    "analyze:dead-code": "knip",
    "check": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:watch": "vitest",
    "db:migrate": "node dist/src/db/migrate.js up",
    "db:migrate:undo": "node dist/src/db/migrate.js down",
    "db:seed": "node dist/src/db/seed.js",
    "keys:generate": "node dist/scripts/generate-jwt-keys.js",
    "media:ensure": "node dist/scripts/ensure-media-directories.js",
    "openapi:validate": "node scripts/validate-openapi.ts",
    "backup:create": "node dist/scripts/create-backup.js",
    "backup:restore": "node dist/scripts/restore-backup.js",
    "docker:smoke": "node dist/scripts/docker-smoke.js",
    "db:seed:demo": "node dist/src/db/seed-demo.js"
  },
  "knip": {
    "entry": [
      "src/worker.ts",
      "src/db/migrate.ts",
      "src/db/seed.ts",
      "scripts/*.ts",
      "tests/**/*.js"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/**/*.ts",
      "tests/**/*.js"
    ],
    "ignore": [
      "src/db/migrations/*.ts"
    ],
    "ignoreDependencies": [
      "mysql2"
    ],
    "ignoreBinaries": [
      "mysql",
      "mysqldump"
    ]
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "argon2": "0.44.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.0.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.10",
    "multer": "2.3.0",
    "mysql2": "3.24.2",
    "nodemailer": "9.1.1",
    "otplib": "13.5.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "rate-limit-redis": "4.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "sequelize": "6.37.8",
    "sharp": "0.35.4",
    "swagger-ui-express": "5.0.1",
    "ulid": "3.0.2",
    "umzug": "3.8.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "9.39.5",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
